@{
    # Настройки окна «Перенос профиля»: скопируйте этот файл в config.psd1 рядом и впишите своё.
    # Чего здесь нет, берётся из defaults.psd1: там все настройки с пояснениями. Чтобы поменять любую из них,
    # перенесите её строку сюда. defaults.psd1 не правьте: при обновлении окна он заменяется.

    # Где хранить копии (обязательно). Открывать папку должны только администраторы: в копиях пароли браузеров
    # и ключи подписей. Шара '\\nas.example.local\Migrate', папка или USB-диск на ПК администратора 'D:\Migrate'
    StoreRoot   = '\\nas.example.local\Migrate'

    # Домен AD. Пусто: домен этого ПК
    Domain      = ''
    # IP контроллера домена, если DNS на ПК администратора подменяет VPN или прокси. Пусто: обычный DNS
    DcIp        = ''

    # Предупреждать, если окно запустили не на ПК администратора. Всё пусто: ПК не проверяется
    AdminPcOu   = ''      # OU с ПК администраторов, например 'OU=Admin PCs,OU=Computers,DC=example,DC=local'
    AdminPCs    = @()     # или их имена, например @('IT-PC-01', 'IT-PC-02')
    AdminGroups = @()     # группы администраторов кроме «Администраторы домена», например @('IT-Admins')

    # Что переносить: лишнее уберите. Ещё папки: 'Pictures', 'Favorites', 'Signatures' (подписи Outlook),
    # 'OfficeTpl' (шаблоны Word), 'Ibases1C' (список баз 1С). Свою папку или браузер: см. README
    Folders     = @('Desktop', 'Documents', 'Downloads')
    Browsers    = @('Yandex', 'ChromiumGost', 'Chrome', 'Edge', 'Firefox')
    EnableCryptoPro = $true   # подписи КриптоПро и личные сертификаты

    # Название организации в шапке акта переноса, например 'ООО «Ромашка»'
    OrgName     = ''
}
